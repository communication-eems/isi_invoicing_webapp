<configuration>
  <appSettings>
    <add key="WSGI_HANDLER" value="config.wsgi.application" />
    <add key="PYTHONPATH" value="C:\apps\isi_invoicing_webapp" />
    <add key="DJANGO_SETTINGS_MODULE" value="config.settings" />
  </appSettings>
  <system.webServer>
    <handlers>
      <add name="Django FastCGI - Invoicing"
           path="*"
           verb="*"
           modules="FastCgiModule"
           scriptProcessor="C:\apps\isi_invoicing_webapp\venv\Scripts\python.exe|C:\apps\isi_invoicing_webapp\venv\Lib\site-packages\wfastcgi.py"
           resourceType="Unspecified"
           requireAccess="Script" />
    </handlers>
  </system.webServer>
</configuration>